<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5">

    <LinearLayout
        android:id="@+id/headerCuenta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@color/verde_corporativo"
        android:paddingTop="40dp"
        android:paddingBottom="16dp"
        android:paddingHorizontal="16dp"
        android:gravity="center_vertical"
        android:elevation="4dp">

        <ImageView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/logo"
            android:layout_marginEnd="12dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="FoodNow"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="@color/amarillo_wireframe"/>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/seccionTitulo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/headerCuenta"
        android:background="@color/blanco"
        android:padding="16dp"
        android:elevation="2dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Resumen de mi cuenta"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/negro_texto"/>
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerCuenta"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/seccionTitulo"
        android:layout_above="@id/contenedorInferior"
        android:padding="8dp"
        android:clipToPadding="false" />

    <LinearLayout
        android:id="@+id/contenedorInferior"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:orientation="vertical"
        android:background="@color/blanco"
        android:paddingHorizontal="20dp"
        android:paddingTop="15dp"
        android:paddingBottom="60dp"  android:elevation="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="15dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Total a pagar:"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/negro_texto"/>

            <TextView
                android:id="@+id/txtTotalCuenta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0.00 €"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="@color/verde_corporativo"/>
        </LinearLayout>

        <Button
            android:id="@+id/btnPedirCuentaDefinitivo"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="PEDIR LA CUENTA"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/amarillo_wireframe"
            android:backgroundTint="@color/verde_corporativo"
            app:cornerRadius="12dp"
            android:elevation="4dp" />

    </LinearLayout>

</RelativeLayout>
<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/verde_corporativo">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:layout_centerInParent="true"
        android:padding="30dp"
        android:layout_marginBottom="40dp">

        <ImageView
            android:layout_width="200dp"
            android:layout_height="200dp"
            android:src="@drawable/logo"
            android:layout_marginBottom="8dp"
            android:contentDescription="Logo FoodNow" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="FoodNow"
            android:textColor="@color/amarillo_wireframe"
            android:textSize="45sp"
            android:textStyle="bold"
            android:layout_marginBottom="10dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Bienvenido a tu experiencia gastronómica inteligente"
            android:textColor="@color/blanco"
            android:textSize="16sp"
            android:textAlignment="center"
            android:layout_marginBottom="60dp"/>

        <Button
            android:id="@+id/btnScanner"
            android:layout_width="match_parent"
            android:layout_height="70dp"
            android:text="ESCANEAR QR"
            android:textSize="18sp"
            android:textStyle="bold"
            android:backgroundTint="@color/verde_oscuro"
            android:textColor="@color/amarillo_wireframe"
            android:elevation="8dp"/>

    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        android:layout_marginBottom="30dp"
        android:text="Desarrollado por Noel FoodNow"
        android:textColor="#80FFFFFF"
        android:textSize="12sp"/>

</RelativeLayout>
<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="8dp"
    android:layout_marginVertical="4dp"
    app:cardCornerRadius="8dp"
    app:cardElevation="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/txtCantidadItemCuenta"
            android:layout_width="35dp"
            android:layout_height="wrap_content"
            android:text="2x"
            android:textStyle="bold"
            android:textColor="@color/verde_corporativo"
            android:textSize="16sp"/>

        <TextView
            android:id="@+id/txtNombreItemCuenta"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Nombre del Plato"
            android:textColor="@color/negro_texto"
            android:textSize="16sp"/>

        <TextView
            android:id="@+id/txtPrecioItemCuenta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0.00 €"
            android:textStyle="bold"
            android:textColor="@color/negro_texto"
            android:textSize="16sp"/>

    </LinearLayout>
</androidx.cardview.widget.CardView>
<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/fondo_gris">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Resumen de Pedido"
        android:textSize="22sp"
        android:textStyle="bold"
        android:paddingTop="40dp"
        android:paddingBottom="20dp"
        android:background="@color/verde_corporativo"
        android:textColor="@color/amarillo_wireframe"
        android:textAlignment="center"/>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerCarrito"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="10dp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/blanco"
        android:paddingTop="20dp"
        android:paddingBottom="60dp"
        android:paddingHorizontal="30dp"
        android:elevation="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="25dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="TOTAL"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/negro_texto"/>

            <TextView
                android:id="@+id/txtTotalPedido"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0.00 €"
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="@color/verde_corporativo"/>
        </LinearLayout>

        <Button
            android:id="@+id/btnEnviarPedido"
            android:layout_width="match_parent"
            android:layout_height="65dp"
            android:text="ENVIAR PEDIDO"
            android:textSize="18sp"
            android:textStyle="bold"
            android:backgroundTint="@color/verde_corporativo"
            android:textColor="@color/amarillo_wireframe"
            android:elevation="6dp"/>
    </LinearLayout>
</LinearLayout>